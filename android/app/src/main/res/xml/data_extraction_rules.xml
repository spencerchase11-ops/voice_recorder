<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Recordings still being saved (files/pending) and the
     dates and lengths read from the recordings (recording_info.json: names of
     this phone's files, useless elsewhere) are neither backed up nor copied to
     a new device; settings may be. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pending/" />
        <exclude domain="file" path="recording_info.json" />
        <exclude domain="file" path="recording_info.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pending/" />
        <exclude domain="file" path="recording_info.json" />
        <exclude domain="file" path="recording_info.json.tmp" />
    </device-transfer>
</data-extraction-rules>
