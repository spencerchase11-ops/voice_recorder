<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Recordings still being saved (files/pending) are
     neither backed up nor copied to a new device; settings may be. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pending/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pending/" />
    </device-transfer>
</data-extraction-rules>
